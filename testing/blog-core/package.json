{
  "name": "@my-blog/core",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "pnpm run '/^lint:(?!.*(fix)).*$/'",
    "lint:fix": "pnpm run '/^lint:[^:]*:fix/'",
    "lint:js": "oxlint .",
    "lint:js:fix": "oxlint . --fix",
    "lint:types": "tsc --noEmit",
    "start": "tsdown --watch",
    "test": "vitest"
  },
  "devDependencies": {
    "@gossi/config-oxfmt": "workspace:*",
    "@gossi/config-oxlint": "workspace:*",
    "@gossi/config-targets": "workspace:*",
    "@types/node": "~24",
    "eslint": "catalog:lint",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "catalog:lint",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:test"
  },
  "engines": {
    "node": ">=24"
  }
}
