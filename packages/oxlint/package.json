{
  "name": "@gossi/config-oxlint",
  "version": "0.0.0",
  "repository": "https://github.com/gossi/frontend-configs",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./base": {
      "types": "./src/configs/base.d.ts",
      "default": "./src/configs/base.js"
    },
    "./node": {
      "types": "./src/configs/node.d.ts",
      "default": "./src/configs/node.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "pnpm run '/^lint:(?!.*(fix)).*$/'",
    "lint:fix": "pnpm run '/^lint:[^:]*:fix/'",
    "lint:js": "oxlint .",
    "lint:js:fix": "oxlint . --fix"
  },
  "devDependencies": {
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint"
  },
  "peerDependencies": {
    "oxlint": "^1.89.0"
  },
  "engines": {
    "node": ">=24"
  }
}
