{
  "name": "@gossi/config-targets",
  "version": "1.1.3",
  "repository": "https://github.com/gossi/frontend-configs",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "require": "./src/index.cjs",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "pnpm run '/^lint:(?!.*(fix)).*$/'",
    "lint:fix": "pnpm run '/^lint:[^:]*:fix/'",
    "lint:js": "oxlint .",
    "lint:js:fix": "oxlint . --fix"
  },
  "devDependencies": {
    "@gossi/config-oxfmt": "workspace:*",
    "@gossi/config-oxlint": "workspace:*",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint"
  },
  "engines": {
    "node": ">=24"
  }
}
