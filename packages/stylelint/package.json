{
  "name": "@gossi/config-stylelint",
  "version": "1.1.5",
  "repository": "https://github.com/gossi/frontend-configs",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "pnpm run '/^lint:(?!.*(fix)).*$/'",
    "lint:fix": "pnpm run '/^lint:[^:]*:fix/'",
    "lint:js": "oxlint .",
    "lint:js:fix": "oxlint . --fix"
  },
  "dependencies": {
    "@gossi/config-targets": "workspace:*",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.0.2"
  },
  "devDependencies": {
    "@gossi/config-oxfmt": "workspace:*",
    "@gossi/config-oxlint": "workspace:*",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "stylelint": "catalog:lint"
  },
  "peerDependencies": {
    "stylelint": "^17.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
