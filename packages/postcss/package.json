{
  "name": "@gossi/config-postcss",
  "version": "1.1.4",
  "description": "postcss config",
  "repository": "https://github.com/gossi/frontend-configs",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "pnpm run '/^lint:(?!.*(fix)).*$/'",
    "lint:fix": "pnpm run '/^lint:[^:]*:fix/'",
    "lint:js": "oxlint .",
    "lint:js:fix": "oxlint . --fix"
  },
  "dependencies": {
    "@gossi/config-targets": "workspace:*",
    "postcss-each": "^1.1.0",
    "postcss-lightningcss": "^1.0.1",
    "postcss-preset-env": "^11.0.0"
  },
  "devDependencies": {
    "@gossi/config-oxfmt": "workspace:*",
    "@gossi/config-oxlint": "workspace:*",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "postcss": "catalog:lint"
  },
  "peerDependencies": {
    "postcss": "^8.4.24"
  },
  "engines": {
    "node": ">=24"
  }
}
